{
  "name": "cdx",
  "version": "22.0.0-alpha.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com/clarivate-prod/cdx-next.git"
  },
  "workspaces": [
    "packages/**"
  ],
  "scripts": {
    "build": "node tools/scripts/exclude-build.js",
    "build:website": "nx run docs-website:build-site --skip-nx-cache",
    "commit": "cz",
    "deploy:cdn": "nx run-many --all --exclude=workspace --target=deploy:cdn --parallel=1 --skip-nx-cache",
    "deploy:website": "deploy-aws-s3-cloudfront --debug --non-interactive --source ./dist/packages/docs-website --delete --invalidation-path '/*'",
    "lint": "run-s lint:*",
    "lint:commit": "commitlint --from cea7d787c9e",
    "lint:nx": "run-s lint:nx:*",
    "lint:nx:format": "nx format:write --all --skip-nx-cache",
    "lint:nx:lint": "nx run-many --all --exclude=workspace --target=lint --skip-nx-cache",
    "lint:patterns": "node tools/patterns/generate-pattern-ai.mjs --check",
    "patterns:ai": "node tools/patterns/generate-pattern-ai.mjs",
    "publish:prerelease": "npm run publish:release:common -- --tag=alpha",
    "publish:release": "npm run publish:release:common -- --tag=latest",
    "publish:release:common": "nx run-many --all --exclude=workspace --target=deploy --parallel=1 --skip-nx-cache",
    "test": "nx run-many --all --exclude=workspace --target=test --skip-nx-cache"
  },
  "dependencies": {
    "@angular/animations": "22.1.2",
    "@angular/cdk": "22.1.2",
    "@angular/common": "22.1.2",
    "@angular/compiler": "22.1.2",
    "@angular/core": "22.1.2",
    "@angular/forms": "22.1.2",
    "@angular/material": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@angular/router": "22.1.2",
    "@ngx-translate/core": "^18.0.0",
    "ag-grid-angular": "^36.1.0",
    "ag-grid-community": "^36.1.0",
    "xng-breadcrumb": "^15.0.0"
  },
  "devDependencies": {
    "@analogjs/storybook-angular": "^2.8.0",
    "@analogjs/vite-plugin-angular": "^2.7.0",
    "@analogjs/vitest-angular": "^2.7.0",
    "@angular-devkit/architect": "0.2201.4",
    "@angular-devkit/build-angular": "22.1.3",
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/build": "22.1.4",
    "@angular/cli": "22.1.4",
    "@angular/compiler-cli": "22.1.2",
    "@angular/platform-browser-dynamic": "^22.1.2",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/config-nx-scopes": "^21.2.0",
    "@commitlint/cz-commitlint": "^21.2.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.2",
    "@namics/stylelint-bem": "^11.1.0",
    "@ngneat/spectator": "^22.1.0",
    "@nx/angular": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "^23.1.1",
    "@nx/web": "23.1.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/angular": "^10.6.1",
    "@types/common-tags": "^1.8.4",
    "@types/jsuri": "^1.3.35",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/utils": "8.67.0",
    "angular-eslint": "22.1.0",
    "commitizen": "^4.3.2",
    "common-tags": "^1.8.2",
    "cross-env": "^10.1.0",
    "deploy-aws-s3-cloudfront": "^3.8.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "jsonc-eslint-parser": "^3.2.0",
    "lint-staged": "^17.3.0",
    "ng-packagr": "22.1.1",
    "ngx-deploy-npm": "9.2.1",
    "npm-groovy-lint": "^18.0.0",
    "npm-run-all": "^4.1.5",
    "nx": "23.1.1",
    "nx-stylelint": "^19.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-sort-json": "4.2.0",
    "storybook": "^10.6.1",
    "stylelint": "^17.14.1",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript-eslint": "8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
