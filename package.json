{
  "name": "cdx",
  "version": "18.1.0-alpha.5",
  "private": true,
  "repository": {
    "type": "git",
    "url": "ssh://git@git.clarivate.io/cdxn/cdx-next.git"
  },
  "workspaces": [
    "packages/**"
  ],
  "scripts": {
    "adr:new": "log4brains adr new",
    "adr:preview": "log4brains preview",
    "build": "nx run-many --all --exclude=workspace --target=build --skip-nx-cache",
    "build:storybooks": "nx run-many --all --exclude=workspace --target=build-storybook --parallel=false --skip-nx-cache",
    "commit": "cz",
    "deploy:cdn": "nx run-many --all --exclude=workspace --target=deploy:cdn --parallel=1 --skip-nx-cache",
    "deploy:storybooks:demo": "deploy-aws-s3-cloudfront --debug --non-interactive --source ./dist/storybook/demo --delete --invalidation-path '/*'",
    "deploy:storybooks:rcx-demo": "deploy-aws-s3-cloudfront --debug --non-interactive --source ./dist/storybook/rcx-demo --delete --invalidation-path '/*'",
    "lint": "run-s lint:*",
    "lint:commit": "commitlint --from cea7d787c9e",
    "lint:nx": "run-s lint:nx:*",
    "lint:nx:format": "nx format:check --skip-nx-cache",
    "lint:nx:lint": "nx run-many --all --exclude=workspace --target=lint --skip-nx-cache",
    "lint:nx:stylelint": "nx run-many --all --exclude=workspace --target=stylelint --skip-nx-cache",
    "prepare": "husky install",
    "publish:prerelease": "npm run publish:release:common -- --tag=alpha",
    "publish:release": "npm run publish:release:common -- --tag=latest",
    "publish:release:common": "nx run-many --all --exclude=workspace --target=deploy --parallel=1 --skip-nx-cache",
    "test": "nx run-many --all --exclude=workspace --target=test --skip-nx-cache"
  },
