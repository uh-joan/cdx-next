{
  "name": "cdx",
  "version": "2.0.0-alpha.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "ssh://git@git.clarivate.io/cdxn/cdx-next.git"
  },
  "workspaces": [
    "packages/**"
  ],
  "scripts": {
    "adr:new": "log4brains adr new",
    "adr:preview": "log4brains preview",
    "build": "nx run-many --all --target=build",
    "commit": "cz",
    "deploy:storybook": "deploy-aws-s3-cloudfront --debug --non-interactive --source ./dist/storybook/demo --delete --invalidation-path '/*'",
    "lint": "run-s lint:*",
    "lint:commit": "commitlint --from",
    "lint:jenkins": "npm-groovy-lint --failon warning --noserver --no-insight --ignorepattern **/node_modules/** --files **/Jenkinsfile",
    "lint:json": "jsonsort --ci --nodemodules=false '**.json'",
    "lint:nx": "run-s lint:nx:*",
    "lint:nx:format": "nx format:check",
    "lint:nx:lint": "nx run-many --all --target=lint",
    "lint:nx:stylelint": "nx run-many --all --target=stylelint",
    "postinstall": "ngcc --properties es2015 browser module main",
    "prepare": "is-ci || husky install",
    "test": "nx run-many --all --target=test"
  },
  "dependencies": {
    "@angular/animations": "~13.2.0",
    "@angular/cdk": "~13.2.0",
    "@angular/common": "~13.2.0",
    "@angular/compiler": "~13.2.0",
    "@angular/core": "~13.2.0",
    "@angular/forms": "~13.2.0",
    "@angular/material": "~13.2.0",
    "@angular/platform-browser": "~13.2.0",
    "@angular/platform-browser-dynamic": "~13.2.0",
    "@angular/router": "~13.2.0",
    "rxjs": "~7.4.0",
    "tslib": "^2.0.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~13.2.0",
    "@angular-eslint/eslint-plugin": "~13.0.1",
    "@angular-eslint/eslint-plugin-template": "~13.0.1",
    "@angular-eslint/template-parser": "~13.0.1",
    "@angular/cli": "~13.2.0",
    "@angular/compiler-cli": "~13.2.0",
    "@angular/language-service": "~13.2.0",
    "@commitlint/cli": "^16.1.0",
    "@commitlint/config-conventional": "^16.0.0",
    "@commitlint/config-nx-scopes": "^16.2.0",
    "@commitlint/cz-commitlint": "^16.1.0",
    "@namics/stylelint-bem": "^7.0.0",
    "@ngneat/spectator": "^10.0.0",
    "@nrwl/angular": "13.8.0",
    "@nrwl/cli": "13.8.0",
    "@nrwl/eslint-plugin-nx": "13.8.0",
    "@nrwl/jest": "13.8.0",
    "@nrwl/linter": "13.8.0",
    "@nrwl/storybook": "13.8.0",
    "@nrwl/tao": "13.8.0",
    "@nrwl/workspace": "13.8.0",
    "@storybook/addon-a11y": "^6.4.18",
    "@storybook/addon-essentials": "~6.4.12",
    "@storybook/angular": "~6.4.12",
    "@storybook/builder-webpack5": "~6.4.12",
    "@storybook/manager-webpack5": "~6.4.12",
    "@types/common-tags": "^1.8.1",
    "@types/jest": "27.0.2",
    "@types/node": "16.11.7",
    "@typescript-eslint/eslint-plugin": "~5.10.0",
    "@typescript-eslint/parser": "~5.10.0",
    "commitizen": "^4.2.4",
    "common-tags": "^1.8.2",
    "deploy-aws-s3-cloudfront": "^3.6.0",
    "eslint": "~8.7.0",
    "eslint-config-prettier": "8.1.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "husky": "^7.0.4",
    "is-ci": "^3.0.1",
    "jest": "27.2.3",
    "jest-preset-angular": "11.0.0",
    "json-sort-cli": "1.19.0",
    "lint-staged": "^12.3.2",
    "log4brains": "^1.0.0-beta.11",
    "ng-packagr": "^13.0.0",
    "npm-groovy-lint": "^9.4.1",
    "npm-run-all": "^4.1.5",
    "nx-stylelint": "^13.2.0",
    "postcss": "^8.4.5",
    "postcss-import": "^14.0.2",
    "postcss-preset-env": "^6.7.0",
    "postcss-url": "^10.1.1",
    "prettier": "^2.5.1",
    "stylelint": "^14.3.0",
    "stylelint-config-idiomatic-order": "^8.1.0",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-standard": "^24.0.0",
    "stylelint-config-standard-scss": "^3.0.0",
    "ts-jest": "27.0.5",
    "typescript": "~4.5.2"
  }
}
