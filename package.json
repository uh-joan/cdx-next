{
  "name": "cdx",
  "version": "19.1.0-alpha.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "ssh://git@git.clarivate.io/cdxn/cdx-next.git"
  },
  "workspaces": [
    "packages/**"
  ],
  "scripts": {
    "adr:new": "log4brains adr new",
    "adr:preview": "log4brains preview",
    "build": "node tools/scripts/exclude-build.js",
    "build:website": "nx run docs-website:build --skip-nx-cache",
    "commit": "cz",
    "deploy:cdn": "nx run-many --all --exclude=workspace --target=deploy:cdn --parallel=1 --skip-nx-cache",
    "deploy:website": "deploy-aws-s3-cloudfront --debug --non-interactive --source ./dist/packages/docs-website --delete --invalidation-path '/*'",
    "lint": "run-s lint:*",
    "lint:commit": "commitlint --from cea7d787c9e",
    "lint:nx": "run-s lint:nx:*",
    "lint:nx:format": "nx format:check --skip-nx-cache",
    "lint:nx:lint": "nx run-many --all --exclude=workspace --target=lint --skip-nx-cache",
    "prepare": "husky install",
    "publish:prerelease": "npm run publish:release:common -- --tag=alpha",
    "publish:release": "npm run publish:release:common -- --tag=latest",
    "publish:release:common": "nx run-many --all --exclude=workspace --target=deploy --parallel=1 --skip-nx-cache",
    "test": "nx run-many --all --exclude=workspace,docs-website --target=test --skip-nx-cache"
  },
