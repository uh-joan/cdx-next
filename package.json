{
  "name": "cdx",
  "version": "2.1.9",
  "private": true,
  "repository": {
    "type": "git",
    "url": "ssh://git@git.clarivate.io/cdxn/cdx-next.git"
  },
  "workspaces": [
    "packages/**"
  ],
  "scripts": {
    "adr:new": "log4brains adr new",
    "adr:preview": "log4brains preview",
    "build": "nx run-many --all --exclude=workspace --target=build",
    "build:storybooks": "nx run-many --all --exclude=workspace --target=build-storybook",
    "commit": "cz",
    "deploy:cdn": "nx run-many --all --exclude=workspace --target=deploy:cdn --parallel=1",
    "deploy:storybooks:demo": "deploy-aws-s3-cloudfront --debug --non-interactive --source ./dist/storybook/demo --delete --invalidation-path '/*'",
    "lint": "run-s lint:*",
    "lint:commit": "commitlint --from a575076",
    "lint:jenkins": "npm-groovy-lint --failon warning --noserver --no-insight --ignorepattern **/node_modules/** --files **/Jenkinsfile",
    "lint:nx": "run-s lint:nx:*",
    "lint:nx:format": "nx format:check",
    "lint:nx:lint": "nx run-many --all --exclude=workspace --target=lint",
    "lint:nx:stylelint": "nx run-many --all --exclude=workspace --target=stylelint",
    "postinstall": "ngcc --properties es2020 browser module main",
    "prepare": "husky install",
    "publish:prerelease": "npm run publish:release:common -- --tag=alpha",
    "publish:release": "npm run publish:release:common -- --tag=latest",
    "publish:release:common": "nx run-many --all --exclude=workspace --target=deploy --parallel=1",
    "test": "nx run-many --all --exclude=workspace --target=test",
    "version:prerelease": "nx run workspace:version --releaseAs=prerelease --preid=alpha",
    "version:release": "nx run workspace:version"
  },
  "dependencies": {
    "@angular/animations": "14.2.6",
    "@angular/cdk": "14.2.5",
    "@angular/common": "14.2.6",
    "@angular/compiler": "14.2.6",
    "@angular/core": "14.2.6",
    "@angular/elements": "14.2.6",
    "@angular/forms": "14.2.6",
    "@angular/material": "14.2.5",
    "@angular/platform-browser": "14.2.6",
    "@angular/platform-browser-dynamic": "14.2.6",
    "@angular/router": "14.2.6",
    "@auth0/angular-jwt": "^5.0.2",
    "@storybook/core-server": "6.5.11",
    "ag-grid-angular": "^27.1.1",
    "ag-grid-community": "^27.1.0",
    "core-js": "^3.21.1",
    "highcharts": "^10.1.0",
    "highcharts-angular": "^3.0.0",
    "lit": "^2.2.1",
    "material-components-web": "14.0.0",
    "regenerator-runtime": "^0.13.9",
    "rxjs": "~7.5.0",
    "tslib": "^2.0.0",
    "xng-breadcrumb": "^7.2.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "14.2.6",
    "@angular-eslint/eslint-plugin": "14.0.4",
    "@angular-eslint/eslint-plugin-template": "14.0.4",
    "@angular-eslint/template-parser": "14.0.4",
    "@angular/cli": "~14.2.6",
    "@angular/compiler-cli": "14.2.6",
    "@angular/language-service": "14.2.6",
    "@commitlint/cli": "^16.2.1",
    "@commitlint/config-conventional": "^16.2.1",
    "@commitlint/config-nx-scopes": "^16.2.1",
    "@commitlint/cz-commitlint": "^16.2.1",
    "@jscutlery/semver": "^2.21.5",
    "@namics/stylelint-bem": "^7.0.0",
    "@ngneat/spectator": "^10.0.0",
    "@nrwl/angular": "15.0.0",
    "@nrwl/cli": "15.0.0",
    "@nrwl/eslint-plugin-nx": "15.0.0",
    "@nrwl/jest": "15.0.0",
    "@nrwl/js": "15.0.0",
    "@nrwl/linter": "15.0.0",
    "@nrwl/storybook": "15.0.0",
    "@nrwl/web": "15.0.0",
    "@nrwl/workspace": "15.0.0",
    "@storybook/addon-a11y": "^6.5.11",
    "@storybook/addon-essentials": "6.5.11",
    "@storybook/angular": "6.5.11",
    "@storybook/builder-webpack5": "6.5.11",
    "@storybook/manager-webpack5": "6.5.11",
    "@types/common-tags": "^1.8.1",
    "@types/jest": "28.1.8",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/jsuri": "^1.3.30",
    "@types/node": "18.7.1",
    "@typescript-eslint/eslint-plugin": "5.40.1",
    "@typescript-eslint/parser": "5.40.1",
    "babel-jest": "28.1.3",
    "commitizen": "^4.2.4",
    "common-tags": "^1.8.2",
    "cross-env": "^7.0.3",
    "css-minimizer-webpack-plugin": "^3.4.1",
    "deploy-aws-s3-cloudfront": "^3.6.0",
    "eslint": "8.15.0",
    "eslint-config-prettier": "8.1.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "eslint-plugin-storybook": "^0.6.4",
    "extract-loader": "^5.1.0",
    "husky": "^7.0.4",
    "jest": "28.1.3",
    "jest-environment-jsdom": "28.1.1",
    "jest-globals": "^0.1.7",
    "jest-preset-angular": "12.2.2",
    "jsonwebtoken": "^8.5.1",
    "lint-staged": "^12.3.4",
    "lit-scss-loader": "^1.1.0",
    "log4brains": "^1.0.0-beta.11",
    "mini-svg-data-uri": "^1.4.4",
    "ng-packagr": "14.2.1",
    "ngx-deploy-npm": "^3.1.2",
    "npm-groovy-lint": "^9.4.1",
    "npm-run-all": "^4.1.5",
    "nx": "15.0.0",
    "nx-stylelint": "^14.0.2",
    "postcss": "^8.4.7",
    "postcss-import": "14.1.0",
    "postcss-preset-env": "7.5.0",
    "postcss-url": "10.1.3",
    "prettier": "2.7.1",
    "prettier-plugin-packagejson": "^2.2.18",
    "prettier-plugin-sort-json": "0.0.2",
    "stylelint": "^14.5.3",
    "stylelint-config-idiomatic-order": "^8.1.0",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-standard": "^24.0.0",
    "stylelint-config-standard-scss": "^3.0.0",
    "ts-jest": "^29.0.3",
    "ts-node": "10.9.1",
    "typescript": "4.8.4",
    "webpack-cli": "^4.9.2",
    "webpack-merge": "^5.8.0",
    "webpack-remove-empty-scripts": "^0.7.3"
  }
}
