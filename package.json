{
  "name": "cdx",
  "version": "21.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com/clarivate-prod/cdx-next.git"
  },
  "workspaces": [
    "packages/**"
  ],
  "scripts": {
    "build": "node tools/scripts/exclude-build.js",
    "build:website": "nx run docs-website:build --skip-nx-cache",
    "commit": "cz",
    "deploy:cdn": "nx run-many --all --exclude=workspace --target=deploy:cdn --parallel=1 --skip-nx-cache",
    "deploy:website": "deploy-aws-s3-cloudfront --debug --non-interactive --source ./dist/packages/docs-website --delete --invalidation-path '/*'",
    "lint": "run-s lint:*",
    "lint:commit": "commitlint --from cea7d787c9e",
    "lint:nx": "run-s lint:nx:*",
    "lint:nx:format": "nx format:check --skip-nx-cache",
    "lint:nx:lint": "nx run-many --all --exclude=workspace --target=lint --skip-nx-cache",
    "publish:prerelease": "npm run publish:release:common -- --tag=alpha",
    "publish:release": "npm run publish:release:common -- --tag=latest",
    "publish:release:common": "nx run-many --all --exclude=workspace --target=deploy --parallel=1 --skip-nx-cache",
    "test": "nx run-many --all --exclude=workspace,docs-website --target=test --skip-nx-cache"
  },
  "dependencies": {
    "@angular/animations": "22.0.8",
    "@angular/cdk": "22.0.7",
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/forms": "22.0.8",
    "@angular/material": "22.0.7",
    "@angular/platform-browser": "22.0.8",
    "@angular/platform-browser-dynamic": "22.0.8",
    "@angular/router": "22.0.8",
    "@ngx-translate/core": "^18.0.0",
    "ag-grid-angular": "^35.1.0",
    "ag-grid-community": "^35.1.0",
    "xng-breadcrumb": "^14.1.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.2.3",
    "@angular-devkit/architect": "0.2200.9",
    "@angular-devkit/build-angular": "22.0.9",
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/build": "22.0.9",
    "@angular/cli": "22.0.9",
    "@angular/compiler-cli": "22.0.8",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@commitlint/config-nx-scopes": "^20.4.0",
    "@commitlint/cz-commitlint": "^20.4.1",
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.2",
    "@namics/stylelint-bem": "^11.0.0",
    "@ngneat/spectator": "^19.4.1",
    "@nx/angular": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/jest": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/web": "23.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/common-tags": "^1.8.4",
    "@types/jest": "^30.0.0",
    "@types/jsuri": "^1.3.35",
    "@types/node": "^25.3.0",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/utils": "8.65.0",
    "angular-eslint": "22.1.0",
    "commitizen": "^4.2.4",
    "common-tags": "^1.8.2",
    "cross-env": "^10.1.0",
    "deploy-aws-s3-cloudfront": "^3.6.0",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "jest": "30.3.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-globals": "^0.1.7",
    "jest-preset-angular": "17.0.0",
    "jest-util": "^30.2.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^16.2.7",
    "ng-packagr": "22.0.2",
    "ngx-deploy-npm": "9.0.0",
    "npm-groovy-lint": "^16.1.1",
    "npm-run-all": "^4.1.5",
    "nx": "23.1.1",
    "nx-cloud": "19.1.3",
    "nx-stylelint": "^18.0.2",
    "postcss": "8.5.6",
    "postcss-import": "16.1.1",
    "postcss-preset-env": "11.1.3",
    "postcss-url": "10.1.3",
    "prettier": "^3.8.1",
    "prettier-plugin-packagejson": "3.0.0",
    "prettier-plugin-sort-json": "4.2.0",
    "stylelint": "^16.6.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0"
  }
}
