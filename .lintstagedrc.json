{
  "*.{js,ts,jsx,tsx}": ["eslint --fix"],
  "*.{md,mdx,html,js,json,ts,jsx,tsx,scss,css,yml,yaml}": ["prettier --write"],
  "*.{scss,css}": ["stylelint --fix"],
  "Jenkinsfile": [
    "npm-groovy-lint --failon warning --noserver --no-insight --ignorepattern **/node_modules/** --files **/Jenkinsfile --fix"
  ]
}
