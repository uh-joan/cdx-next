{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "declaration": false,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "lib": ["es2020", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@cdx/demo": ["packages/demo/src/index.ts"],
      "@cdx/ngx-analytics": ["packages/ngx-analytics/src/index.ts"],
      "@hlx/ngx-authentication": ["packages/ngx-authentication/src/index.ts"],
      "@hlx/ngx-branding": ["packages/ngx-branding/src/index.ts"],
      "@hlx/helix-icons": ["packages/helix-icons/src/index.ts"],
      "@cdx/ngx-session-activity": [
        "packages/ngx-session-activity/src/index.ts"
      ],
      "@hlx/ngx-translations": ["packages/ngx-translations/src/index.ts"],
      "@hlx/oti-snippet": ["packages/oti-snippet/src/index.ts"],
      "@hlx/theme-angular-material": [
        "packages/theme-angular-material/src/index.ts"
      ],
      "@cdx/theme-ag-grid": ["packages/theme-ag-grid/dist/theme-ag-grid.mjs"],
      "@cdx/theme-highcharts": [
        "packages/theme-highcharts/dist/theme-highcharts.mjs"
      ],
      "@hlx/theme-xng-breadcrumb": [
        "packages/theme-xng-breadcrumb/src/index.ts"
      ]
    },
    "resolveJsonModule": true,
    "rootDir": ".",
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "es2020"
  },
  "exclude": ["node_modules", "tmp"]
}
