{
  "projects": {
    "branding": "packages/branding",
    "clarivate-font": "packages/clarivate-font",
    "demo": "packages/demo",
    "ngx-branding": "packages/ngx-branding",
    "theme-ag-grid": "packages/theme-ag-grid",
    "theme-angular-material": "packages/theme-angular-material",
    "theme-badge": "packages/theme-badge",
    "theme-button-toggle": "packages/theme-button-toggle",
    "theme-material-components-web": "packages/theme-material-components-web",
    "theme-popperjs": "packages/theme-popperjs",
    "workspace": {
      "root": ".",
      "targets": {
        "version": {
          "executor": "@jscutlery/semver:version",
          "options": {
            "commitMessageFormat": "chore(${projectName}): release version ${version} [skip ci]",
            "push": false,
            "skipProjectChangelog": true,
            "skipRootChangelog": true,
            "syncVersions": true
          }
        }
      }
    }
  },
  "version": 2
}
