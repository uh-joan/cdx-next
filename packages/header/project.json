{
  "prefix": "cdx",
  "projectType": "library",
  "root": "packages/header",
  "sourceRoot": "packages/header/src",
  "tags": [],
  "targets": {
    "build": {
      "configurations": {
        "development": {
          "tsConfig": "packages/header/tsconfig.lib.json"
        },
        "production": {
          "tsConfig": "packages/header/tsconfig.lib.prod.json"
        }
      },
      "defaultConfiguration": "production",
      "executor": "@nrwl/angular:package",
      "options": {
        "project": "packages/header/ng-package.json"
      },
      "outputs": ["dist/packages/header"]
    },
    "build-storybook": {
      "configurations": {
        "ci": {
          "quiet": true
        }
      },
      "executor": "@nrwl/storybook:build",
      "options": {
        "config": {
          "configFolder": "packages/header/.storybook"
        },
        "outputPath": "dist/storybook/header",
        "projectBuildConfig": "header:build-storybook",
        "uiFramework": "@storybook/angular"
      },
      "outputs": ["{options.outputPath}"]
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": [
          "packages/header/src/**/*.ts",
          "packages/header/src/**/*.html"
        ]
      }
    },
    "storybook": {
      "configurations": {
        "ci": {
          "quiet": true
        }
      },
      "executor": "@nrwl/storybook:storybook",
      "options": {
        "config": {
          "configFolder": "packages/header/.storybook"
        },
        "port": 4400,
        "projectBuildConfig": "header:build-storybook",
        "uiFramework": "@storybook/angular"
      }
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "options": {
        "lintFilePatterns": ["packages/header/**/*.css"]
      },
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "packages/header/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/packages/header"]
    }
  }
}
