{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "theme-angular-material",
  "prefix": "cdx",
  "projectType": "library",
  "sourceRoot": "packages/theme-angular-material/src",
  "tags": [],
  "targets": {
    "build": {
      "configurations": {
        "development": {
          "tsConfig": "packages/theme-angular-material/tsconfig.lib.json"
        },
        "production": {
          "tsConfig": "packages/theme-angular-material/tsconfig.lib.prod.json"
        }
      },
      "defaultConfiguration": "production",
      "executor": "@nrwl/angular:package",
      "options": {
        "project": "packages/theme-angular-material/ng-package.json"
      },
      "outputs": ["{workspaceRoot}/dist/packages/theme-angular-material"]
    },
    "deploy": {
      "executor": "ngx-deploy-npm:deploy"
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": [
          "packages/theme-angular-material/src/**/*.ts",
          "packages/theme-angular-material/src/**/*.html"
        ]
      }
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "options": {
        "lintFilePatterns": [
          "packages/theme-angular-material/**/*.css",
          "packages/theme-angular-material/**/*.scss"
        ]
      },
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "packages/theme-angular-material/jest.config.ts",
        "passWithNoTests": true
      },
      "outputs": ["{workspaceRoot}/coverage/packages/theme-angular-material"]
    }
  }
}
