{
  "name": "@hlx/clarivate-font",
  "version": "22.0.0-alpha.1",
  "description": "Clarivate brand font (@font-face CSS + self-hosted web-font files), consumed by importing its CSS.",
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com/clarivate-prod/cdx-next.git",
    "directory": "packages/clarivate-font"
  },
  "style": "css/clarivate-font.css",
  "sideEffects": [
    "css/clarivate-font.css"
  ],
  "exports": {
    ".": "./css/clarivate-font.css",
    "./css/clarivate-font.css": "./css/clarivate-font.css"
  },
  "files": [
    "css",
    "fonts"
  ],
  "scripts": {
    "deploy:cdn": "deploy-aws-s3-cloudfront --bucket cdx-cdn.digital-experience.clarivate.io --distribution EF022SLU13YUI --source css --destination @cdx/clarivate-font/latest --non-interactive"
  }
}
