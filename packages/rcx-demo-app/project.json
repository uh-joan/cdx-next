{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "rcx-demo-app",
  "projectType": "application",
  "sourceRoot": "packages/rcx-demo-app/src",
  "tags": [],
  "targets": {
    "build": {
      "configurations": {
        "development": {
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true,
          "vendorChunk": true
        },
        "production": {
          "extractLicenses": true,
          "fileReplacements": [
            {
              "replace": "packages/rcx-demo-app/src/environments/environment.ts",
              "with": "packages/rcx-demo-app/src/environments/environment.prod.ts"
            }
          ],
          "namedChunks": false,
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "vendorChunk": false
        }
      },
      "defaultConfiguration": "production",
      "executor": "@nrwl/webpack:webpack",
      "options": {
        "assets": [
          "packages/rcx-demo-app/src/favicon.ico",
          "packages/rcx-demo-app/src/assets"
        ],
        "baseHref": "/",
        "compiler": "babel",
        "index": "packages/rcx-demo-app/src/index.html",
        "isolatedConfig": true,
        "main": "packages/rcx-demo-app/src/main.tsx",
        "outputPath": "dist/packages/rcx-demo-app",
        "polyfills": "packages/rcx-demo-app/src/polyfills.ts",
        "scripts": [],
        "styles": ["packages/rcx-demo-app/src/styles.scss"],
        "tsConfig": "packages/rcx-demo-app/tsconfig.app.json",
        "webpackConfig": "packages/rcx-demo-app/webpack.config.js"
      },
      "outputs": ["{options.outputPath}"]
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["packages/rcx-demo-app/**/*.{ts,tsx,js,jsx}"]
      },
      "outputs": ["{options.outputFile}"]
    },
    "serve": {
      "configurations": {
        "development": {
          "buildTarget": "rcx-demo-app:build:development"
        },
        "production": {
          "buildTarget": "rcx-demo-app:build:production",
          "hmr": false
        }
      },
      "defaultConfiguration": "development",
      "executor": "@nrwl/webpack:dev-server",
      "options": {
        "buildTarget": "rcx-demo-app:build",
        "hmr": true
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "packages/rcx-demo-app/jest.config.ts",
        "passWithNoTests": true
      },
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"]
    }
  }
}
