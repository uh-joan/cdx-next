{
  "prefix": "cdx",
  "projectType": "library",
  "root": "packages/cookies",
  "sourceRoot": "packages/cookies/src",
  "tags": [],
  "targets": {
    "build": {
      "configurations": {
        "development": {
          "tsConfig": "packages/cookies/tsconfig.lib.json"
        },
        "production": {
          "tsConfig": "packages/cookies/tsconfig.lib.prod.json"
        }
      },
      "defaultConfiguration": "production",
      "executor": "@nrwl/angular:package",
      "options": {
        "project": "packages/cookies/ng-package.json"
      },
      "outputs": ["dist/packages/cookies"]
    },
    "deploy": {
      "executor": "ngx-deploy-npm:deploy",
      "options": {
        "access": "public",
        "buildTarget": "production"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": [
          "packages/cookies/src/**/*.ts",
          "packages/cookies/src/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "packages/cookies/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/packages/cookies"]
    }
  }
}
