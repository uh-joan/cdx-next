{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "demo",
  "prefix": "cdx",
  "projectType": "library",
  "sourceRoot": "packages/demo/src",
  "tags": [],
  "targets": {
    "build-storybook": {
      "configurations": {
        "ci": {
          "docsMode": true,
          "quiet": true
        }
      },
      "executor": "@storybook/angular:build-storybook",
      "options": {
        "browserTarget": "demo:build-storybook",
        "compodoc": false,
        "configDir": "packages/demo/.storybook",
        "outputDir": "dist/storybook/demo",
        "styles": [
          ".storybook/theme-setup.scss",
          "packages/demo/src/lib/stories.scss"
        ]
      },
      "outputs": ["{options.outputPath}"]
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": [
          "packages/demo/src/**/*.ts",
          "packages/demo/src/**/*.html"
        ]
      }
    },
    "storybook": {
      "configurations": {
        "ci": {
          "docsMode": true,
          "quiet": true
        }
      },
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "browserTarget": "demo:build-storybook",
        "compodoc": false,
        "configDir": "packages/demo/.storybook",
        "port": 4400,
        "styles": [
          ".storybook/theme-setup.scss",
          "packages/demo/src/lib/stories.scss"
        ]
      }
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "options": {
        "lintFilePatterns": [
          "packages/demo/**/*.css",
          "packages/demo/**/*.scss"
        ]
      },
      "outputs": ["{options.outputFile}"]
    }
  }
}
