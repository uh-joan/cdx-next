{
  "prefix": "cdx-next",
  "projectType": "library",
  "root": "packages/demo",
  "sourceRoot": "packages/demo/src",
  "tags": [],
  "targets": {
    "build-storybook": {
      "configurations": {
        "ci": {
          "quiet": true
        }
      },
      "executor": "@nrwl/storybook:build",
      "options": {
        "config": {
          "configFolder": "packages/demo/.storybook"
        },
        "outputPath": "dist/storybook/demo",
        "projectBuildConfig": "demo:build-storybook",
        "uiFramework": "@storybook/angular"
      },
      "outputs": ["{options.outputPath}"]
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": [
          "packages/demo/src/**/*.ts",
          "packages/demo/src/**/*.html"
        ]
      }
    },
    "storybook": {
      "configurations": {
        "ci": {
          "quiet": true
        }
      },
      "executor": "@nrwl/storybook:storybook",
      "options": {
        "config": {
          "configFolder": "packages/demo/.storybook"
        },
        "port": 4400,
        "projectBuildConfig": "demo:build-storybook",
        "uiFramework": "@storybook/angular"
      }
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "options": {
        "lintFilePatterns": [
          "packages/demo/**/*.css",
          "packages/demo/**/*.scss"
        ]
      },
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "packages/demo/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/packages/demo"]
    }
  }
}
