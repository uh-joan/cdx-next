{
  "prefix": "cdx",
  "projectType": "library",
  "root": "packages/web-components",
  "sourceRoot": "packages/web-components/src",
  "tags": [],
  "targets": {
    "build": {
      "configurations": {
        "development": {
          "tsConfig": "packages/web-components/tsconfig.lib.json"
        },
        "production": {
          "tsConfig": "packages/web-components/tsconfig.lib.prod.json"
        }
      },
      "defaultConfiguration": "production",
      "executor": "@nrwl/angular:package",
      "options": {
        "project": "packages/web-components/ng-package.json"
      },
      "outputs": ["dist/packages/web-components"]
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": [
          "packages/web-components/src/**/*.ts",
          "packages/web-components/src/**/*.html"
        ]
      }
    }
  }
}
