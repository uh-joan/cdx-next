{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "seed-app",
  "prefix": "app",
  "projectType": "application",
  "sourceRoot": "packages/seed-app/src",
  "tags": [],
  "targets": {
    "build": {
      "configurations": {
        "development": {
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true
        },
        "production": {
          "budgets": [
            {
              "maximumError": "1mb",
              "maximumWarning": "500kb",
              "type": "initial"
            },
            {
              "maximumError": "8kb",
              "maximumWarning": "4kb",
              "type": "anyComponentStyle"
            }
          ],
          "outputHashing": "all"
        }
      },
      "defaultConfiguration": "production",
      "executor": "@angular/build:application",
      "options": {
        "assets": [
          {
            "glob": "**/*",
            "input": "packages/seed-app/public"
          }
        ],
        "browser": "packages/seed-app/src/main.ts",
        "inlineStyleLanguage": "scss",
        "outputPath": "dist/packages/seed-app",
        "polyfills": ["zone.js"],
        "styles": ["packages/seed-app/src/styles.scss"],
        "tsConfig": "packages/seed-app/tsconfig.app.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "seed-app:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve": {
      "configurations": {
        "development": {
          "buildTarget": "seed-app:build:development"
        },
        "production": {
          "buildTarget": "seed-app:build:production"
        }
      },
      "continuous": true,
      "defaultConfiguration": "development",
      "executor": "@angular/build:dev-server"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "seed-app:build",
        "spa": true,
        "staticFilePath": "dist/packages/seed-app/browser"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "packages/seed-app/jest.config.ts",
        "tsConfig": "packages/seed-app/tsconfig.spec.json"
      },
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"]
    }
  }
}
