{
  "name": "ngx-reference-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "prefix": "app",
  "projectType": "application",
  "sourceRoot": "packages/ngx-reference-app/src",
  "tags": ["exclude-from-build"],
  "targets": {
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "ngx-reference-app:build"
      }
    },
    "lint": {
      "options": {
        "args": ["src/**/*.ts", "src/**/*.html"]
      }
    }
  }
}
