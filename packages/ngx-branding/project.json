{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ngx-branding",
  "prefix": "cdx",
  "projectType": "library",
  "sourceRoot": "packages/ngx-branding/src",
  "tags": [],
  "targets": {
    "build": {
      "configurations": {
        "development": {
          "tsConfig": "packages/ngx-branding/tsconfig.lib.json"
        },
        "production": {
          "tsConfig": "packages/ngx-branding/tsconfig.lib.prod.json"
        }
      },
      "defaultConfiguration": "production",
      "executor": "@nx/angular:package",
      "options": {
        "project": "packages/ngx-branding/ng-package.json"
      },
      "outputs": ["{workspaceRoot}/dist/packages/ngx-branding"]
    },
    "deploy": {
      "executor": "ngx-deploy-npm:deploy",
      "options": {
        "distFolderPath": "{workspaceRoot}/dist/packages/ngx-branding"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "packages/ngx-branding/src/**/*.ts",
          "packages/ngx-branding/src/**/*.html"
        ]
      }
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "options": {
        "lintFilePatterns": [
          "packages/ngx-branding/**/*.css",
          "packages/ngx-branding/**/*.scss"
        ]
      },
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "packages/ngx-branding/jest.config.ts",
        "passWithNoTests": true
      },
      "outputs": ["{workspaceRoot}/coverage/packages/ngx-branding"]
    }
  }
}
