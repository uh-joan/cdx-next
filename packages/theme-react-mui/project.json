{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "root": "packages/theme-react-mui",
  "sourceRoot": "packages/theme-react-mui/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nrwl/web:rollup",
      "options": {
        "assets": [
          {
            "glob": "packages/theme-react-mui/README.md",
            "input": ".",
            "output": "."
          }
        ],
        "compiler": "babel",
        "entryFile": "packages/theme-react-mui/src/index.ts",
        "external": ["react/jsx-runtime"],
        "main": "packages/theme-react-mui/src/index.ts",
        "outputPath": "dist/packages/theme-react-mui",
        "project": "packages/theme-react-mui/package.json",
        "rollupConfig": "@nrwl/react/plugins/bundle-rollup",
        "tsConfig": "packages/theme-react-mui/tsconfig.lib.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "deploy": {
      "executor": "ngx-deploy-npm:deploy"
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["packages/theme-react-mui/**/*.{ts,tsx,js,jsx}"]
      },
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "packages/theme-react-mui/jest.config.ts",
        "passWithNoTests": true
      },
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"]
    }
  }
}
