{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "theme-xng-breadcrumb",
  "prefix": "cdx",
  "projectType": "library",
  "sourceRoot": "packages/theme-xng-breadcrumb/src",
  "tags": [],
  "targets": {
    "build": {
      "configurations": {
        "development": {
          "tsConfig": "packages/theme-xng-breadcrumb/tsconfig.lib.json"
        },
        "production": {
          "tsConfig": "packages/theme-xng-breadcrumb/tsconfig.lib.prod.json"
        }
      },
      "defaultConfiguration": "production",
      "executor": "@nx/angular:package",
      "options": {
        "project": "packages/theme-xng-breadcrumb/ng-package.json"
      },
      "outputs": ["{workspaceRoot}/dist/packages/theme-xng-breadcrumb"]
    },
    "deploy": {
      "executor": "ngx-deploy-npm:deploy"
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": [
          "packages/theme-xng-breadcrumb/src/**/*.ts",
          "packages/theme-xng-breadcrumb/src/**/*.html"
        ]
      }
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "options": {
        "lintFilePatterns": [
          "packages/theme-xng-breadcrumb/**/*.css",
          "packages/theme-xng-breadcrumb/**/*.scss"
        ]
      },
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "packages/theme-xng-breadcrumb/jest.config.ts",
        "passWithNoTests": true
      },
      "outputs": ["{workspaceRoot}/coverage/packages/theme-xng-breadcrumb"]
    }
  }
}
