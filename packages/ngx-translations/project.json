{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ngx-translations",
  "prefix": "cdx",
  "projectType": "library",
  "sourceRoot": "packages/ngx-translations/src",
  "tags": [],
  "targets": {
    "build": {
      "configurations": {
        "development": {
          "tsConfig": "packages/ngx-translations/tsconfig.lib.json"
        },
        "production": {
          "tsConfig": "packages/ngx-translations/tsconfig.lib.prod.json"
        }
      },
      "defaultConfiguration": "production",
      "executor": "@nx/angular:package",
      "options": {
        "project": "packages/ngx-translations/ng-package.json"
      },
      "outputs": ["{workspaceRoot}/dist/packages/ngx-translations"]
    },
    "deploy": {
      "executor": "ngx-deploy-npm:deploy",
      "options": {
        "access": "public"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": [
          "packages/ngx-translations/src/**/*.ts",
          "packages/ngx-translations/src/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "packages/ngx-translations/jest.config.ts",
        "passWithNoTests": true
      },
      "outputs": ["{workspaceRoot}/coverage/packages/ngx-translations"]
    }
  }
}
