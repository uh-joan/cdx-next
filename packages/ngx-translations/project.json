{
  "name": "ngx-translations",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "prefix": "cdx",
  "projectType": "library",
  "sourceRoot": "packages/ngx-translations/src",
  "tags": [],
  "targets": {
    "build": {
      "defaultConfiguration": "production",
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/packages/ngx-translations"],
      "options": {
        "project": "packages/ngx-translations/ng-package.json"
      },
      "configurations": {
        "development": {
          "tsConfig": "packages/ngx-translations/tsconfig.lib.json"
        },
        "production": {
          "tsConfig": "packages/ngx-translations/tsconfig.lib.prod.json"
        }
      }
    },
    "deploy": {
      "executor": "ngx-deploy-npm:deploy",
      "options": {
        "access": "public",
        "distFolderPath": "{workspaceRoot}/dist/packages/ngx-translations"
      }
    },
    "lint": {
      "options": {
        "args": ["**/*.ts"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config packages/ngx-translations/vitest.config.mjs",
        "passWithNoTests": true
      }
    }
  }
}
