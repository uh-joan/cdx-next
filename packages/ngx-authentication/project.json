{
  "projectType": "library",
  "root": "packages/ngx-authentication",
  "sourceRoot": "packages/ngx-authentication/src",
  "tags": [],
  "targets": {
    "build": {
      "configurations": {
        "development": {
          "tsConfig": "packages/ngx-authentication/tsconfig.lib.json"
        },
        "production": {
          "tsConfig": "packages/ngx-authentication/tsconfig.lib.prod.json"
        }
      },
      "defaultConfiguration": "production",
      "executor": "@nrwl/angular:package",
      "options": {
        "project": "packages/ngx-authentication/ng-package.json"
      },
      "outputs": ["dist/packages/ngx-authentication"]
    },
    "deploy": {
      "executor": "ngx-deploy-npm:deploy",
      "options": {
        "access": "public"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["packages/ngx-authentication/**/*.ts"]
      },
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "packages/ngx-authentication/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/packages/ngx-authentication"]
    }
  }
}
