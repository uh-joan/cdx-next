{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ngx-authentication",
  "projectType": "library",
  "sourceRoot": "packages/ngx-authentication/src",
  "tags": [],
  "targets": {
    "build": {
      "configurations": {
        "development": {
          "tsConfig": "packages/ngx-authentication/tsconfig.lib.json"
        },
        "production": {
          "tsConfig": "packages/ngx-authentication/tsconfig.lib.prod.json"
        }
      },
      "defaultConfiguration": "production",
      "executor": "@nrwl/angular:package",
      "options": {
        "project": "packages/ngx-authentication/ng-package.json"
      },
      "outputs": ["{workspaceRoot}/dist/packages/ngx-authentication"]
    },
    "build-storybook": {
      "configurations": {
        "ci": {
          "quiet": true
        }
      },
      "executor": "@storybook/angular:build-storybook",
      "options": {
        "browserTarget": "ngx-authentication:build-storybook",
        "compodoc": false,
        "configDir": "packages/ngx-branding/.storybook",
        "outputDir": "dist/storybook/ngx-authentication",
        "styles": [".storybook/theme-setup.scss"]
      },
      "outputs": ["{options.outputPath}"]
    },
    "deploy": {
      "executor": "ngx-deploy-npm:deploy",
      "options": {
        "access": "public"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["packages/ngx-authentication/**/*.ts"]
      },
      "outputs": ["{options.outputFile}"]
    },
    "storybook": {
      "configurations": {
        "ci": {
          "quiet": true
        }
      },
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "browserTarget": "ngx-branding:build-storybook",
        "compodoc": false,
        "configDir": "packages/ngx-authentication/.storybook",
        "port": 4400,
        "styles": [".storybook/theme-setup.scss"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "packages/ngx-authentication/jest.config.ts",
        "passWithNoTests": true
      },
      "outputs": ["{workspaceRoot}/coverage/packages/ngx-authentication"]
    }
  }
}
