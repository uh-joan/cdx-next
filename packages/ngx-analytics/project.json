{
  "name": "ngx-analytics",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "prefix": "cdx",
  "projectType": "library",
  "sourceRoot": "packages/ngx-analytics/src",
  "tags": [],
  "targets": {
    "build": {
      "defaultConfiguration": "production",
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/packages/ngx-analytics"],
      "options": {
        "project": "packages/ngx-analytics/ng-package.json"
      },
      "configurations": {
        "development": {
          "tsConfig": "packages/ngx-analytics/tsconfig.lib.json"
        },
        "production": {
          "tsConfig": "packages/ngx-analytics/tsconfig.lib.prod.json"
        }
      }
    },
    "deploy": {
      "executor": "ngx-deploy-npm:deploy",
      "options": {
        "distFolderPath": "{workspaceRoot}/dist/packages/ngx-analytics"
      }
    },
    "lint": {
      "options": {
        "args": ["**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/packages/ngx-analytics"],
      "options": {
        "jestConfig": "packages/ngx-analytics/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
