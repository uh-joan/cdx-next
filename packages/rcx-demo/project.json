{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "rcx-demo",
  "projectType": "library",
  "sourceRoot": "packages/rcx-demo/src",
  "tags": ["exclude-from-build"],
  "targets": {
    "build-storybook": {
      "configurations": {
        "ci": {
          "quiet": true
        }
      },
      "executor": "@nrwl/storybook:build",
      "options": {
        "configDir": "packages/rcx-demo/.storybook",
        "outputDir": "dist/storybook/rcx-demo"
      },
      "outputs": ["{options.outputDir}"]
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["packages/rcx-demo/**/*.{ts,tsx,js,jsx}"]
      },
      "outputs": ["{options.outputFile}"]
    },
    "storybook": {
      "configurations": {
        "ci": {
          "quiet": true
        }
      },
      "executor": "@nrwl/storybook:storybook",
      "options": {
        "configDir": "packages/rcx-demo/.storybook",
        "port": 4400
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "packages/rcx-demo/jest.config.ts",
        "passWithNoTests": true
      },
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"]
    }
  }
}
