{
  "name": "helix-icons",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/helix-icons/src",
  "tags": [],
  "targets": {
    "build": {
      "defaultConfiguration": "production",
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/packages/helix-icons"],
      "options": {
        "project": "packages/helix-icons/ng-package.json"
      },
      "configurations": {
        "development": {
          "tsConfig": "packages/helix-icons/tsconfig.lib.json"
        },
        "production": {
          "tsConfig": "packages/helix-icons/tsconfig.lib.prod.json"
        }
      }
    },
    "deploy": {
      "executor": "ngx-deploy-npm:deploy",
      "options": {
        "access": "public",
        "distFolderPath": "{workspaceRoot}/dist/packages/helix-icons"
      }
    },
    "lint": {
      "options": {
        "args": ["**/*.ts"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config packages/helix-icons/vitest.config.mjs",
        "passWithNoTests": true
      }
    }
  }
}
