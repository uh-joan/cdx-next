{
  "name": "docs-website",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/docs-website/src",
  "tags": ["exclude-from-build"],
  "targets": {
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "docs-website:build"
      }
    },
    "lint": {
      "options": {
        "args": ["src/**/*.ts", "src/**/*.html"]
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "docs-website:build",
        "port": 4200,
        "spa": true,
        "staticFilePath": "dist/packages/docs-website"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config packages/docs-website/vitest.config.mjs"
      },
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}",
        "{workspaceRoot}/coverage/packages/docs-website"
      ]
    }
  }
}
