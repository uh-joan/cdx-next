{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "docs-website",
  "projectType": "application",
  "sourceRoot": "packages/docs-website/src",
  "tags": ["exclude-from-build"],
  "targets": {
    "build": {
      "configurations": {
        "development": {
          "allowedCommonJsDependencies": ["sha1", "uuid"],
          "buildOptimizer": false,
          "extractLicenses": false,
          "namedChunks": true,
          "optimization": false,
          "sourceMap": true,
          "vendorChunk": true
        },
        "production": {
          "budgets": [
            {
              "maximumError": "5mb",
              "maximumWarning": "500kb",
              "type": "initial"
            },
            {
              "maximumError": "1mb",
              "maximumWarning": "4kb",
              "type": "anyComponentStyle"
            }
          ],
          "outputHashing": "all"
        }
      },
      "defaultConfiguration": "production",
      "executor": "@angular-devkit/build-angular:browser",
      "options": {
        "assets": [
          "packages/docs-website/src/favicon.ico",
          "packages/docs-website/src/assets"
        ],
        "index": "packages/docs-website/src/index.html",
        "inlineStyleLanguage": "scss",
        "main": "packages/docs-website/src/main.ts",
        "outputPath": "dist/packages/docs-website",
        "polyfills": ["zone.js"],
        "scripts": [],
        "styles": ["packages/docs-website/src/styles.scss"],
        "tsConfig": "packages/docs-website/tsconfig.app.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "docs-website:build"
      }
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "options": {
        "lintFilePatterns": [
          "packages/docs-website/src/**/*.ts",
          "packages/docs-website/src/**/*.html"
        ]
      }
    },
    "serve": {
      "configurations": {
        "development": {
          "buildTarget": "docs-website:build:development"
        },
        "production": {
          "buildTarget": "docs-website:build:production"
        }
      },
      "continuous": true,
      "defaultConfiguration": "development",
      "executor": "@angular-devkit/build-angular:dev-server"
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "docs-website:build",
        "port": 4200,
        "spa": true,
        "staticFilePath": "dist/packages/docs-website/browser"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "packages/docs-website/jest.config.ts"
      },
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"]
    }
  }
}
