{
  "name": "ngx-demo-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "prefix": "demo",
  "projectType": "application",
  "sourceRoot": "packages/ngx-demo-app/src",
  "tags": ["exclude-from-build"],
  "targets": {
    "build": {
      "defaultConfiguration": "production",
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "assets": [
          "packages/ngx-demo-app/src/favicon.ico",
          "packages/ngx-demo-app/src/assets"
        ],
        "index": "packages/ngx-demo-app/src/index.html",
        "inlineStyleLanguage": "scss",
        "main": "packages/ngx-demo-app/src/main.ts",
        "outputPath": "dist/packages/ngx-demo-app",
        "scripts": [],
        "styles": ["packages/ngx-demo-app/src/styles.scss"],
        "tsConfig": "packages/ngx-demo-app/tsconfig.app.json"
      },
      "configurations": {
        "development": {
          "allowedCommonJsDependencies": [
            "sha1",
            "uuid",
            "highcharts/highcharts"
          ],
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true
        },
        "production": {
          "allowedCommonJsDependencies": [
            "sha1",
            "uuid",
            "highcharts/highcharts"
          ],
          "budgets": [
            {
              "maximumError": "4mb",
              "maximumWarning": "500kb",
              "type": "initial"
            },
            {
              "maximumError": "100kb",
              "maximumWarning": "2kb",
              "type": "anyComponentStyle"
            }
          ],
          "outputHashing": "all"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "ngx-demo-app:build"
      }
    },
    "lint": {
      "options": {
        "args": ["**/*.ts", "**/*.html"]
      }
    },
    "serve": {
      "continuous": true,
      "defaultConfiguration": "development",
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "development": {
          "buildTarget": "ngx-demo-app:build:development"
        },
        "production": {
          "buildTarget": "ngx-demo-app:build:production"
        }
      }
    }
  }
}
