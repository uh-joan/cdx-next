{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ngx-notification",
  "prefix": "cdx",
  "projectType": "library",
  "sourceRoot": "packages/ngx-notification/src",
  "tags": [],
  "targets": {
    "build": {
      "configurations": {
        "development": {
          "tsConfig": "packages/ngx-notification/tsconfig.lib.json"
        },
        "production": {
          "tsConfig": "packages/ngx-notification/tsconfig.lib.prod.json"
        }
      },
      "defaultConfiguration": "production",
      "executor": "@nx/angular:package",
      "options": {
        "project": "packages/ngx-notification/ng-package.json"
      },
      "outputs": ["{workspaceRoot}/dist/packages/ngx-notification"]
    },
    "deploy": {
      "executor": "ngx-deploy-npm:deploy",
      "options": {
        "distFolderPath": "{workspaceRoot}/dist/packages/ngx-notification"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": [
          "packages/ngx-notification/src/**/*.ts",
          "packages/ngx-notification/src/**/*.html"
        ]
      }
    },
    "storybook": {
      "configurations": {
        "ci": {
          "quiet": true
        }
      },
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "browserTarget": "ngx-notification:build-storybook",
        "compodoc": false,
        "configDir": "packages/ngx-notification/.storybook",
        "port": 4400,
        "styles": [".storybook/theme-setup.scss"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "packages/ngx-notification/jest.config.ts",
        "passWithNoTests": true
      },
      "outputs": ["{workspaceRoot}/coverage/packages/ngx-notification"]
    }
  }
}
