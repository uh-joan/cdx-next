{
  "projectType": "library",
  "root": "packages/rcx-analytics",
  "sourceRoot": "packages/rcx-analytics/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nrwl/web:rollup",
      "options": {
        "assets": [
          {
            "glob": "packages/rcx-analytics/README.md",
            "input": ".",
            "output": "."
          }
        ],
        "compiler": "babel",
        "entryFile": "packages/rcx-analytics/src/index.ts",
        "external": ["react/jsx-runtime"],
        "outputPath": "dist/packages/rcx-analytics",
        "project": "packages/rcx-analytics/package.json",
        "rollupConfig": "@nrwl/react/plugins/bundle-rollup",
        "tsConfig": "packages/rcx-analytics/tsconfig.lib.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["packages/rcx-analytics/**/*.{ts,tsx,js,jsx}"]
      },
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "packages/rcx-analytics/jest.config.ts",
        "passWithNoTests": true
      },
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"]
    }
  }
}
