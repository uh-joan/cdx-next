{
  "name": "@cdx/theme-highcharts",
  "version": "18.2.0-alpha.5",
  "repository": {
    "type": "git",
    "url": "ssh://git@git.clarivate.io/cdxn/cdx-next.git",
    "directory": "packages/theme-highcharts"
  },
  "exports": {
    ".": {
      "sass": "./theme-highcharts.scss",
      "import": "./index.ts",
      "/dist/theme-highcharts.min.css": "./dist/theme-highcharts.min.css"
    }
  },
  "files": [
    "dist",
    "*.scss",
    "*.ts"
  ],
  "scripts": {
    "build": "webpack",
    "deploy": "npm publish",
    "deploy:cdn": "deploy-aws-s3-cloudfront --bucket cdx-cdn.digital-experience.clarivate.io --distribution EF022SLU13YUI --source dist --destination @cdx/theme-highcharts/${VERSION:-latest} --non-interactive"
  },
  "dependencies": {
    "highcharts": "^11.3.0"
  },
  "baseUrl": "."
}
