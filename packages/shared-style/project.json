{
  "root": "packages/shared-style",
  "targets": {
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "options": {
        "lintFilePatterns": [
          "packages/shared-style/**/*.css",
          "packages/shared-style/**/*.scss"
        ]
      },
      "outputs": ["{options.outputFile}"]
    }
  }
}
