{
  "prefix": "cdx",
  "projectType": "library",
  "root": "packages/branding",
  "sourceRoot": "packages/branding/src",
  "tags": [],
  "targets": {
    "build": {
      "configurations": {
        "development": {
          "tsConfig": "packages/branding/tsconfig.lib.json"
        },
        "production": {
          "tsConfig": "packages/branding/tsconfig.lib.prod.json"
        }
      },
      "defaultConfiguration": "production",
      "executor": "@nrwl/angular:package",
      "options": {
        "project": "packages/branding/ng-package.json"
      },
      "outputs": ["dist/packages/branding"]
    },
    "build-storybook": {
      "configurations": {
        "ci": {
          "quiet": true
        }
      },
      "executor": "@nrwl/storybook:build",
      "options": {
        "config": {
          "configFolder": "packages/branding/.storybook"
        },
        "outputPath": "dist/storybook/branding",
        "projectBuildConfig": "branding:build-storybook",
        "uiFramework": "@storybook/angular"
      },
      "outputs": ["{options.outputPath}"]
    },
    "deploy": {
      "executor": "ngx-deploy-npm:deploy"
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": [
          "packages/branding/src/**/*.ts",
          "packages/branding/src/**/*.html"
        ]
      }
    },
    "storybook": {
      "configurations": {
        "ci": {
          "quiet": true
        }
      },
      "executor": "@nrwl/storybook:storybook",
      "options": {
        "config": {
          "configFolder": "packages/branding/.storybook"
        },
        "port": 4400,
        "projectBuildConfig": "branding:build-storybook",
        "uiFramework": "@storybook/angular"
      }
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "options": {
        "lintFilePatterns": [
          "packages/branding/**/*.css",
          "packages/branding/**/*.scss"
        ]
      },
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "packages/branding/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/packages/branding"]
    }
  }
}
