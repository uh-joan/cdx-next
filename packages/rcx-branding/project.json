{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["theme-react-mui"],
  "name": "rcx-branding",
  "projectType": "library",
  "sourceRoot": "packages/rcx-branding/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/rollup:rollup",
      "options": {
        "assets": [
          {
            "glob": "packages/rcx-branding/README.md",
            "input": ".",
            "output": "."
          }
        ],
        "compiler": "babel",
        "entryFile": "packages/rcx-branding/src/index.ts",
        "external": ["react/jsx-runtime"],
        "outputPath": "dist/packages/rcx-branding",
        "project": "packages/rcx-branding/package.json",
        "rollupConfig": "@nx/react/plugins/bundle-rollup",
        "tsConfig": "packages/rcx-branding/tsconfig.lib.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "deploy": {
      "executor": "ngx-deploy-npm:deploy",
      "options": {
        "distFolderPath": "{workspaceRoot}/dist/packages/rcx-branding"
      }
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "options": {
        "lintFilePatterns": ["packages/rcx-branding/**/*.{ts,tsx,js,jsx}"]
      },
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "packages/rcx-branding/jest.config.ts",
        "passWithNoTests": true
      },
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"]
    }
  }
}
