{
  "name": "@cdx/theme-ag-grid",
  "version": "18.2.0-alpha.3",
  "repository": {
    "type": "git",
    "url": "ssh://git@git.clarivate.io/cdxn/cdx-next.git",
    "directory": "packages/theme-ag-grid"
  },
  "exports": {
    ".": {
      "sass": "./theme-ag-grid.scss",
      "/dist/theme-ag-grid.min.css": "./dist/theme-ag-grid.min.css"
    }
  },
  "files": [
    "dist",
    "*.scss"
  ],
  "scripts": {
    "build": "webpack",
    "deploy": "npm publish",
    "deploy:cdn": "deploy-aws-s3-cloudfront --bucket cdx-cdn.digital-experience.clarivate.io --distribution EF022SLU13YUI --source dist --destination @cdx/theme-ag-grid/${VERSION:-latest} --non-interactive"
  },
  "peerDependencies": {
    "ag-grid-community": ">=28"
  }
}
