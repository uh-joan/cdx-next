{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "defaultProject": "demo",
  "extends": "nx/presets/core.json",
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "none",
      "linter": "eslint",
      "style": "scss",
      "unitTestRunner": "vitest"
    },
    "@nx/angular:component": {
      "style": "scss",
      "type": "component"
    },
    "@nx/angular:directive": {
      "type": "directive"
    },
    "@nx/angular:guard": {
      "typeSeparator": "."
    },
    "@nx/angular:interceptor": {
      "typeSeparator": "."
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "vitest"
    },
    "@nx/angular:module": {
      "typeSeparator": "."
    },
    "@nx/angular:pipe": {
      "typeSeparator": "."
    },
    "@nx/angular:resolver": {
      "typeSeparator": "."
    },
    "@nx/angular:scam": {
      "type": "component"
    },
    "@nx/angular:scam-directive": {
      "type": "directive"
    },
    "@nx/angular:service": {
      "type": "service"
    },
    "@nx/react": {
      "application": {
        "linter": "eslint",
        "style": "scss"
      },
      "component": {
        "style": "scss"
      },
      "library": {
        "linter": "eslint",
        "style": "scss"
      }
    },
    "@nx/web:application": {
      "e2eTestRunner": "none",
      "linter": "eslint",
      "style": "scss",
      "unitTestRunner": "vitest"
    },
    "@nx/web:library": {
      "linter": "eslint",
      "style": "scss",
      "unitTestRunner": "vitest"
    },
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    },
    "@schematics/angular:service": {
      "type": "service"
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/vitest.config.[jt]s",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/eslint.config.mjs"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/.stylelintrc.json",
      "{workspaceRoot}/.stylelintrc.json"
    ]
  },
  "plugins": [
    {
      "options": {
        "targetName": "eslint:lint"
      },
      "plugin": "@nx/eslint/plugin"
    },
    {
      "options": {
        "build": {
          "buildDepsName": "tsc:build-deps",
          "configName": "tsconfig.lib.json",
          "targetName": "tsc:build",
          "watchDepsName": "tsc:watch-deps"
        },
        "typecheck": {
          "targetName": "typecheck"
        }
      },
      "plugin": "@nx/js/typescript"
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
        "packages/docs-website/**/*",
        "packages/ngx-analytics/**/*",
        "packages/ngx-authentication/**/*",
        "packages/ngx-branding/**/*",
        "packages/ngx-demo-app/**/*",
        "packages/ngx-reference-app/**/*",
        "packages/ngx-session-activity/**/*",
        "packages/ngx-translations/**/*",
        "packages/theme-angular-material/**/*",
        "packages/theme-xng-breadcrumb/**/*"
      ]
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "previewTargetName": "preview",
        "testTargetName": "test",
        "serveStaticTargetName": "serve-static"
      },
      "include": [
        "packages/docs-website/**/*",
        "packages/ngx-analytics/**/*",
        "packages/ngx-authentication/**/*",
        "packages/ngx-branding/**/*",
        "packages/ngx-reference-app/**/*",
        "packages/ngx-session-activity/**/*",
        "packages/ngx-translations/**/*",
        "packages/theme-angular-material/**/*",
        "packages/theme-xng-breadcrumb/**/*"
      ]
    }
  ],
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": true
    }
  },
  "release": {
    "git": {
      "commitMessage": "chore(workspace): release {version} [skip ci]"
    },
    "projects": [
      "packages/clarivate-font",
      "packages/colors",
      "packages/ngx-analytics",
      "packages/ngx-authentication",
      "packages/ngx-branding",
      "packages/ngx-session-activity",
      "packages/ngx-translations",
      "packages/oti-snippet",
      "packages/shared-branding",
      "packages/theme-ag-grid",
      "packages/theme-angular-material",
      "packages/theme-highcharts",
      "packages/theme-snackbar",
      "packages/theme-xng-breadcrumb",
      "."
    ]
  },
  "targetDefaults": {
    "@angular/build:application": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "e2e": {
      "cache": true
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/eslint.config.mjs"
      ]
    },
    "stylelint": {
      "cache": true
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production", "{projectRoot}/vitest.config.mjs"]
    }
  },
  "workspaceLayout": {
    "appsDir": "packages",
    "libsDir": "packages"
  },
  "analytics": false
}
